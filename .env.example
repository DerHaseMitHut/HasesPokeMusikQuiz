# Supabase (client-side, safe to expose publicly — RLS is the real access gate)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# LiveKit (client-side URL, safe to expose)
VITE_LIVEKIT_URL=

# LiveKit (server-side only, used by netlify/functions/livekit-token.ts — never exposed to the client)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
